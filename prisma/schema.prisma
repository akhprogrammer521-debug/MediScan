generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * =======================
 * ENUMS
 * =======================
 */

enum Role {
  ADMIN
  PATIENT
  PHARMACIST
}

enum Gender {
  MALE
  FEMALE
}

enum MedicationStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  SYSTEM
  ORDER
  MESSAGE
}

enum SystemType {
  ADMIN
  PHARMACY
  PATIENT
}

enum SettingScope {
  GLOBAL
  USER
  PHARMACY
}

/**
 * =======================
 * USER & AUTH
 * =======================
 */

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  email    String  @unique
  password String
  role     Role
  isActive Boolean @default(true)

  admin      Admin?
  patient    Patient?
  pharmacist Pharmacist?

  notifications Notification[]

  settings SystemSetting[]

  aiChatMessages AIChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

/**
 * =======================
 * ADMIN
 * =======================
 */

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  @@map("admin")
}

/**
 * =======================
 * PATIENT
 * =======================
 */

model Patient {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  firstName String
  lastName  String
  phone     String

  medicalInfo MedicalInfo?
  medications PatientMedication[]
  orders      Order[]

  doseLogs MedicationDoseLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient")
}

model MedicalInfo {
  id        Int     @id @default(autoincrement())
  patientId Int     @unique
  patient   Patient @relation(fields: [patientId], references: [id])

  gender    Gender
  birthDate DateTime
  height    Float
  weight    Float

  currentMedications String?
  chronicMedications String?
  chronicDiseases    String?
  allergies          String?

  @@map("medicalinfo")
}

/**
 * =======================
 * PATIENT ELECTRONIC PHARMACY
 * =======================
 */

model PatientMedication {
  id        Int     @id @default(autoincrement())
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  name   String
  dosage String
  reason String?
  notes  String?

  status MedicationStatus @default(ACTIVE)

  schedules MedicationSchedule[]
  logs      MedicationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patientmedication")
}

model MedicationLog {
  id Int @id @default(autoincrement())

  patientMedicationId Int
  scheduleId          Int

  takenAt DateTime @default(now())
  date    DateTime

  patientMedication PatientMedication  @relation(fields: [patientMedicationId], references: [id])
  schedule          MedicationSchedule @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, date])
  @@map("medicationlog")
}

model MedicationDoseLog {
  id         Int       @id @default(autoincrement())
  scheduleId Int
  patientId  Int
  date       DateTime
  taken      Boolean   @default(false)
  takenAt    DateTime?

  schedule MedicationSchedule @relation(fields: [scheduleId], references: [id])
  patient  Patient            @relation(fields: [patientId], references: [id])

  @@unique([scheduleId, date])
  @@map("medicationdoselog")
}

model MedicationSchedule {
  id                  Int               @id @default(autoincrement())
  patientMedicationId Int
  patientMedication   PatientMedication @relation(fields: [patientMedicationId], references: [id], onDelete: Cascade)
  logs                MedicationLog[]

  time      String
  days      String
  taken     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  doseLogs MedicationDoseLog[]

  @@map("medicationschedule")
}

/**
 * =======================
 * PHARMACIST & PHARMACY
 * =======================
 */

model Pharmacist {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  pharmacy Pharmacy?
  orders   Order[]

  @@map("pharmacist")
}

model Pharmacy {
  id        Int    @id @default(autoincrement())
  name      String
  address   String
  latitude  Float?
  longitude Float?
  phone     String

  licenseNumber    String
  licenseIssuedAt  DateTime
  licenseExpiresAt DateTime

  settings SystemSetting[]

  pharmacistId Int        @unique
  pharmacist   Pharmacist @relation(fields: [pharmacistId], references: [id])

  stocks      PharmacyStock[]
  orders      Order[]
  customDrugs CustomPharmacyDrug[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pharmacy")
}

/**
 * =======================
 * DRUGS (GLOBAL & STOCK)
 * =======================
 */

model Drug {
  id          Int @id @default(autoincrement())

  name        String
  strength    String?
  description String?

  composition       String?
  indications       String?
  contraindications String?
  dosage            String?
  warnings          String?
  sideEffects       String?
  interactions      String?
  overdose          String?

  pharmacyStocks PharmacyStock[]

  interactionsA DrugInteraction[] @relation("DrugA")
  interactionsB DrugInteraction[] @relation("DrugB")

  createdAt DateTime @default(now())

  @@map("drug")
}

model CustomPharmacyDrug {
  id         Int @id @default(autoincrement())
  pharmacyId Int

  name     String
  strength String?
  price    Float
  notes    String?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])
  stock    PharmacyStock[]

  @@map("custompharmacydrug")
}

model PharmacyStock {
  id         Int @id @default(autoincrement())
  pharmacyId Int

  drugId       Int?
  customDrugId Int?

  quantity Int
  price    Float @default(0)

  pharmacy   Pharmacy            @relation(fields: [pharmacyId], references: [id])
  drug       Drug?               @relation(fields: [drugId], references: [id])
  customDrug CustomPharmacyDrug? @relation(fields: [customDrugId], references: [id])

  @@map("pharmacystock")
}

/**
 * =======================
 * DRUG INTERACTIONS
 * =======================
 */

model DrugInteraction {
  id      Int @id @default(autoincrement())
  drugAId Int
  drugBId Int

  severity String
  warning  String

  drugA Drug @relation("DrugA", fields: [drugAId], references: [id])
  drugB Drug @relation("DrugB", fields: [drugBId], references: [id])

  @@unique([drugAId, drugBId])
  @@map("druginteraction")
}

/**
 * =======================
 * ORDERS
 * =======================
 */

model Order {
  id           Int @id @default(autoincrement())
  patientId    Int
  pharmacyId   Int
  pharmacistId Int?

  drugName String
  quantity Int

  prescriptionImage String?

  status OrderStatus @default(PENDING)

  patient    Patient     @relation(fields: [patientId], references: [id])
  pharmacy   Pharmacy    @relation(fields: [pharmacyId], references: [id])
  pharmacist Pharmacist? @relation(fields: [pharmacistId], references: [id])

  createdAt DateTime @default(now())

  @@map("order")
}

/**
 * =======================
 * NOTIFICATIONS
 * =======================
 */

model Notification {
  id Int @id @default(autoincrement())

  userId Int?
  toRole Role?

  type    NotificationType
  title   String
  message String

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("notification")
}

model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String
  value String

  role  Role
  scope SettingScope @default(GLOBAL)

  userId     Int?
  pharmacyId Int?

  user     User?     @relation(fields: [userId], references: [id])
  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@unique([scope, role, key], name: "scope_role_key")
  @@unique([scope, role, key, userId], name: "scope_role_key_userId")
  @@unique([scope, role, key, pharmacyId], name: "scope_role_key_pharmacyId")

  @@map("systemsetting")
}

/**
 * =======================
 * OCR & PRESCRIPTIONS
 * =======================
 */

model OCRScan {
  id       Int    @id @default(autoincrement())
  imageUrl String
  text     String
  language String

  createdAt DateTime @default(now())

  @@map("ocrscan")
}

model Prescription {
  id                Int     @id @default(autoincrement())
  imageUrl          String
  content           String
  translatedContent String?

  createdAt DateTime @default(now())

  @@map("prescription")
}

model AIChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("aichatmessage")
}